# Google OAuth 2.0
# Utwórz dane w: console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=twoj-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=twoj-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# JWT — zmień na losowy ciąg w produkcji
JWT_SECRET=zmien-na-bezpieczny-klucz

# URLs
CLIENT_URL=http://localhost:5173

# Google Service Account (do Sheets API)
GOOGLE_SERVICE_ACCOUNT_PATH=./config/google-service-account.json

# Opcjonalnie: inna ścieżka do bazy SQLite
# DB_PATH=./data/tracker.db
